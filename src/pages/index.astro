---
import Layout from "../layouts/Layout.astro";
import VideoGrid from "../components/VideoGrid.astro";
import { getAllVideos } from "../lib/videos";

const videos = await getAllVideos();
---

<Layout
  title="夜之瞳 - Tsukipool"
  description="夜之瞳（Tsukipool）· 月色真美，风也温柔。在线视频浏览网站：精选视频合集，选集播放，支持标签筛选与全文搜索。"
>
  <section class="hero">
    <p class="hero-overline">T S U K I P O O L</p>
    <h1>月色之下，<span class="accent-text">一部好看的影片</span></h1>
    <p class="hero-sub">精选视频合集 · 选集播放 · 标签筛选 · 全文搜索</p>
  </section>

  <h2 class="section-title">全部视频</h2>
  <VideoGrid videos={videos} />
</Layout>
