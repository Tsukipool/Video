---
import Layout from "../layouts/Layout.astro";
import { buildSearchIndex } from "../lib/search";

const index = await buildSearchIndex();
const initialQuery = Astro.url.searchParams.get("q") ?? "";
---

<Layout title="搜索" description="夜之瞳（Tsukipool）· 搜索视频标题、标签或简介">
  <h1 class="section-title">搜索</h1>

  <form class="search-form" action="/search" method="get" role="search">
    <input
      type="search"
      name="q"
      placeholder="搜索标题、标签或简介"
      value={initialQuery}
      aria-label="搜索视频"
      autocomplete="off"
    />
    <button type="submit">搜索</button>
  </form>

  <noscript>
    <p style="color: var(--muted);">需要启用 JavaScript 才能进行搜索。</p>
  </noscript>

  <div id="search-results" class="video-grid" aria-live="polite"></div>
</Layout>

<script is:inline define:vars={{ index }}>
  const resultsEl = document.getElementById("search-results");
  const params = new URLSearchParams(window.location.search);
  const query = (params.get("q") ?? "").trim();

  function createCard(item) {
    const link = document.createElement("a");
    link.className = "video-card";
    link.href = `/video/${item.slug}`;
    link.setAttribute("aria-label", `${item.title}，${item.episodeCount} 集`);

    const coverWrap = document.createElement("div");
    coverWrap.className = "video-card-cover";

    const img = document.createElement("img");
    img.src = item.cover;
    img.alt = item.title;
    img.loading = "lazy";
    img.decoding = "async";
    img.width = 1280;
    img.height = 720;
    img.onerror = function () {
      this.onerror = null;
      this.src = "/default-cover.webp";
    };

    const count = document.createElement("span");
    count.className = "video-card-episode-count";
    count.textContent = `${item.episodeCount} 集`;

    coverWrap.append(img, count);

    const body = document.createElement("div");
    body.className = "video-card-body";

    const title = document.createElement("h2");
    title.className = "video-card-title";
    title.textContent = item.title;

    const tags = document.createElement("div");
    tags.className = "video-card-tags";
    for (const tag of item.tags) {
      const span = document.createElement("span");
      span.textContent = tag;
      tags.appendChild(span);
    }

    body.append(title, tags);
    link.append(coverWrap, body);
    return link;
  }

  function showEmpty(title, hint) {
    resultsEl.innerHTML = "";
    const box = document.createElement("div");
    box.className = "empty-state";
    const t = document.createElement("p");
    t.className = "empty-title";
    t.textContent = title;
    const h = document.createElement("p");
    h.textContent = hint;
    box.append(t, h);
    resultsEl.append(box);
  }

  if (!query) {
    showEmpty("输入关键词开始搜索", "可以搜索视频标题、标签或简介");
  } else {
    const normalized = query.toLowerCase();
    const results = index.filter((item) =>
      [item.title, item.description, ...item.tags].join("\n").toLowerCase().includes(normalized)
    );

    if (results.length === 0) {
      showEmpty(`没有找到与「${query}」相关的内容`, "换个关键词试试");
    } else {
      resultsEl.innerHTML = "";
      for (const item of results) {
        resultsEl.appendChild(createCard(item));
      }
    }
  }
</script>
