---
import Layout from "../../layouts/Layout.astro";
import VideoGrid from "../../components/VideoGrid.astro";
import { getAllTags, getVideosByTagSlug } from "../../lib/tags";
import { tagNameFromSlug } from "../../lib/slug";

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({
    params: { slug: tag.slug },
  }));
}

const { slug } = Astro.params;
const tagName = tagNameFromSlug(slug ?? "") ?? slug ?? "";
const videos = await getVideosByTagSlug(slug ?? "");
---

<Layout title={`标签：${tagName}`} description={`夜之瞳（Tsukipool）· 标签「${tagName}」下的全部视频`}>
  <h1 class="section-title">
    标签：<span style="color: var(--muted);">{tagName}</span>
  </h1>
  <p style="color: var(--muted); font-size: 0.9rem; margin-bottom: 1rem;">
    共 {videos.length} 个视频
  </p>
  <VideoGrid videos={videos} />
</Layout>
